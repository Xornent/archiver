<UserControl x:Class="Archiver.ExtractPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Archiver"
             xmlns:io="clr-namespace:System.IO;assembly=mscorlib"
             xmlns:tree="clr-namespace:Aga.Controls.Tree">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="510" MaxWidth="510"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="5 25 0 20">
            <StackPanel Orientation="Vertical" Margin="10 0 10 0">
                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Foreground="gray" Text="Source" HorizontalAlignment="Left"
               VerticalAlignment="Top" Width="130" Height="23" TextAlignment="Right"
               TextWrapping="Wrap" LineHeight="17" Padding="5" Margin="0 0 10 0" FontWeight="Regular"/>
                    <StackPanel Orientation="Vertical">
                        <RadioButton Content="Current opening archive" IsChecked="True"/>
                        <RadioButton Content="From batch selection of archives"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox IsEnabled="False" SelectedIndex="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200"
                      Margin="25 0 0 0">
                            </ComboBox>
                            <Button IsEnabled="False" Content="Select ..." Padding="10 0 10 0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid Height="15" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="gray" Text="Destination" HorizontalAlignment="Left"
                               VerticalAlignment="Center" Width="80" Height="23" TextAlignment="Right"
                               TextWrapping="Wrap" LineHeight="17" Padding="5" Margin="0 0 10 0" FontWeight="Regular"/>
                    <ComboBox x:Name="comboBoxDest" Width="300" SelectedIndex="0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type io:DirectoryInfo}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://siteoforigin:,,,/resources/folder.ico" Width="16" Height="16"/>
                                    <Grid Width="5"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBoxItem Content="Same directory with the archive"/>
                    </ComboBox>
                    <Button x:Name="btnSelectDest" IsEnabled="True" Padding="4 0 4 0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="2 1 2 0" Source="Resources/apple-files.png"/>
                            <TextBlock Margin="2 0">Select</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Height="15"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="gray" Text="Exclusion" HorizontalAlignment="Left"
                               VerticalAlignment="Top" Width="80" Height="23" TextAlignment="Right"
                               TextWrapping="Wrap" LineHeight="17" Padding="5" Margin="0 0 10 0" FontWeight="Regular"/>
                    <StackPanel Orientation="Vertical">
                        <RadioButton x:Name="radioExtractAll" Content="Extract all files" IsChecked="True"/>
                        <RadioButton x:Name="radioIncludePart" Content="Only extract a partition of the file"/>
                        <StackPanel x:Name="panelExclusion" Orientation="Vertical" Visibility="Visible">
                            <ComboBox IsEnabled="False" SelectedIndex="0" HorizontalAlignment="Left" 
                                      VerticalAlignment="Top" Width="275" Name="comboExclue"
                                      Margin="25 0 0 0">
                                <ComboBoxItem>Include all</ComboBoxItem>
                            </ComboBox>
                            <StackPanel Margin="25 0 0 0" x:Name="stackWildcardControls" Orientation="Vertical">
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid Height="15"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="gray" Text="Password" HorizontalAlignment="Left"
                               VerticalAlignment="Top" Width="80" Height="23" TextAlignment="Right"
                               TextWrapping="Wrap" LineHeight="17" Padding="5" Margin="0 0 10 0" FontWeight="Regular"/>
                    <StackPanel Orientation="Vertical">
                        <RadioButton x:Name="radioNoPass" Content="No password" IsChecked="True"/>
                        <RadioButton x:Name="radioPass" Content="Specify password to extract this archive"/>
                        <StackPanel x:Name="panelPass" Orientation="Horizontal" Visibility="Collapsed">
                            <PasswordBox x:Name="txtPass" Width="200" Margin="25 0 0 0" FontFamily="{StaticResource fixedWidthFont}"></PasswordBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid Height="15"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="gray" Text="" HorizontalAlignment="Left"
                               VerticalAlignment="Center" Width="80" Height="23" TextAlignment="Right"
                               TextWrapping="Wrap" LineHeight="17" Padding="5" Margin="0 0 10 0" FontWeight="Regular"/>
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="chkRecurse" IsChecked="True" Content="Keep directory structures"/>
                        <CheckBox x:Name="chkSPF" IsEnabled="False" Content="Use absolute path (only for -spf archives)"/>
                    </StackPanel>
                </StackPanel>

                <Grid Height="15"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="gray" Text="Overwritting" HorizontalAlignment="Left"
                               VerticalAlignment="Center" Width="80" Height="23" TextAlignment="Right"
                               TextWrapping="Wrap" LineHeight="17" Padding="5" Margin="0 0 10 0" FontWeight="Regular"/>
                    <ComboBox x:Name="comboAO" HorizontalAlignment="Left" VerticalAlignment="Top" Width="300"
                              SelectedIndex="4">
                        <ComboBoxItem>Overwrite All existing files without prompt</ComboBoxItem>
                        <ComboBoxItem>Skip extracting of existing files</ComboBoxItem>
                        <ComboBoxItem>Auto rename extracting file</ComboBoxItem>
                        <ComboBoxItem>Auto rename existing file</ComboBoxItem>
                        <ComboBoxItem>Remind me</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <Grid Height="15"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Bottom" Height="60">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="20 10 20 20">
                    <Button Style="{StaticResource secondaryButton}" Width="30">
                        <Image Width="20" Height="20" Source="resources/copy.png" IsHitTestVisible="False"/>
                    </Button>
                    <Button Style="{StaticResource secondaryButton}" Width="30" Margin="10 0 0 0">
                        <Image Width="20" Height="20" Source="resources/cut.png" IsHitTestVisible="False"/>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20 10 20 20">
                    <Button Style="{StaticResource secondaryButton}" Width="30" Margin="10 0 0 0">
                        <Image Width="20" Height="20" Source="resources/delete-filled.png" IsHitTestVisible="False"/>
                    </Button>
                </StackPanel>
                <Grid/>
            </DockPanel>
            <tree:TreeList x:Name="tree" Margin="20 20 20 0">
                <tree:TreeList.View>
                    <GridView>
                        <GridView.Columns>

                            <GridViewColumn Width="28">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="16" Height="16"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="260" Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <tree:RowExpander/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Size" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeHumanFriendly}" Width="90" HorizontalAlignment="Stretch"
                                                   TextAlignment="Right" FontFamily="{StaticResource fixedWidthFont}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="#" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Index}" HorizontalAlignment="Stretch"
                                                   TextAlignment="Right" FontFamily="{StaticResource fixedWidthFont}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Method" Width="80" DisplayMemberBinding="{Binding Method}"/>
                            <GridViewColumn Header="Attributes" Width="80" DisplayMemberBinding="{Binding Attributes}"/>
                            <GridViewColumn Header="Last modified" Width="150" DisplayMemberBinding="{Binding DateModified}"/>
                            <GridViewColumn Header="Encrypted" Width="70" DisplayMemberBinding="{Binding IsEncrypted}"/>
                            <GridViewColumn Header="Comment" Width="150" DisplayMemberBinding="{Binding CommentAbstract}"/>

                            <GridViewColumn Header="Archive entry" Width="400">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ArchiveName}" HorizontalAlignment="Stretch"
                                           TextAlignment="Right" FontFamily="{StaticResource fixedWidthFont}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView.Columns>
                    </GridView>
                </tree:TreeList.View>
            </tree:TreeList>
        </DockPanel>
    </Grid>
</UserControl>
